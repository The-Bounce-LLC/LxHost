# ────────────────────────────────────────────────────────────
*.termux
termux-*.sh
scratch/
tmp/
temp/

# ════════════════════════════════════════════════════════════
#  EXCEPTIONS — files we WANT tracked
#  (rule order matters: exceptions must come after the ignores)
# ════════════════════════════════════════════════════════════

# ── Gradle wrapper — required to build ──
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties
!gradlew
!gradlew.bat

# ── Prebuilt CPython + the compiled pybridge library ──
# These live inside pybridge/ and are the raw ingredients for CI.
!pybridge/**/*.so
!pybridge/**/*.a
!pybridge/**/*.c
!pybridge/**/*.h
!pybridge/**/*.mk

# ── Anything placed inside a real jniLibs/ folder must be tracked ──
# (that's where libpybridge.so and libpython3.8m.so end up in your app)
!**/jniLibs/**/*.so
!**/src/main/jniLibs/**/*.so

# ── Python bridge source and bootstrap ──
!pybridge/PyApp/app/src/main/jni/pybridge.c
!pybridge/PyApp/app/src/main/assets/python/bootstrap.py
